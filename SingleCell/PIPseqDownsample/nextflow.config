/*
 * Nextflow configuration file for the PIPseq batch downsample-and-combine pipeline
 */

plugins {
    id 'nf-schema@2.7.3'
}

// Default parameters (can be overridden in run.config or command line)
params {
    outdir = "out"
    batch_basename = "batch_output"

    // Resource allocations
    cpu_summarize_gex_downsample_targets = 2
    memory_gb_summarize_gex_downsample_targets = 8
    cpu_summarize_grna_downsample_targets = 2
    memory_gb_summarize_grna_downsample_targets = 8
    cpu_downsample_molecule_info = 8
    memory_gb_downsample_molecule_info = 32
    cpu_downsample_crispr_anndata = 2
    memory_gb_downsample_crispr_anndata = 8
    cpu_combine_downsampled_batch = 8
    memory_gb_combine_downsampled_batch = 32
    cpu_combine_downsampled_depths = 8
    memory_gb_combine_downsampled_depths = 32
}

// Process configuration
process {
    // Error handling
    errorStrategy = 'terminate'
    maxRetries = 0

    // Container (optional - uncomment if using Docker/Singularity)
    // container = 'continuumio/miniconda3:latest'
}

// Generate execution reports. These are resolved at config-parse time, before
// validateParameters() gets a chance to apply nextflow_schema*.json's defaults, and before
// `workflow`/entrypoint-specific state is available to this file -- so they can only key off
// a param that's guaranteed to have a config-level default no matter which entrypoint is
// running. batch_basename (downsample.nf) is that param; downsample_single_sample.nf runs
// organize pipeline_info/ here under batch_basename's default ("batch_output") too, rather
// than under its own --sample_id, as a result -- a cosmetic-only quirk (every actual data
// output already publishes under sample_id via each module's own publishDir, which has no
// such timing constraint).
timeline {
    enabled = true
    file = "${params.outdir}/${params.batch_basename}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/${params.batch_basename}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/${params.batch_basename}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/${params.batch_basename}/pipeline_info/dag.svg"
    overwrite = true
}

// Manifest
manifest {
    name = 'pipseq-downsample-pipeline'
    author = 'Junjie Xia'
    description = 'Downsampling pipelines for cross-sample and cross-depth PIPseq comparison'
    mainScript = 'downsample.nf'
    nextflowVersion = '>=25.10.0'  // required by the nf-schema plugin version pinned above
    version = '1.0.0'
}
