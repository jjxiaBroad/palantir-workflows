/*
 * Nextflow configuration file for Single-Cell QC Pipeline
 */

plugins {
    id 'nf-schema@2.7.3'
}

// Default parameters (can be overridden in run.config or command line)
params {
    outdir = "out"
    supersample_basename = "output"
    
    // Resource allocations
    concatenate_cpus = 16
    concatenate_memory_gb = 64
    dragen_scratch_tb = 2
    dragen_machine_type = "fpga2-medium"
    cpu_generate_subsample_qc = 8
    memory_gb_generate_subsample_qc = 32
    cpu_generate_supersample_qc = 8
    memory_gb_generate_supersample_qc = 32
    cpu_crispat_guide_assignment = 8
    memory_gb_crispat_guide_assignment = 32
    cpu_purity_based_guide_assignment = 8
    memory_gb_purity_based_guide_assignment = 32

    // downsample.nf resource allocations
    batch_basename = "batch_output"
    cpu_summarize_gex_downsample_targets = 2
    memory_gb_summarize_gex_downsample_targets = 8
    cpu_summarize_grna_downsample_targets = 2
    memory_gb_summarize_grna_downsample_targets = 8
    cpu_downsample_molecule_info = 8
    memory_gb_downsample_molecule_info = 32
    cpu_downsample_crispr_anndata = 2
    memory_gb_downsample_crispr_anndata = 8
    cpu_combine_downsampled_batch = 8
    memory_gb_combine_downsampled_batch = 32
}

// Process configuration
process {
    // Error handling
    errorStrategy = 'terminate'
    maxRetries = 0

    // Container (optional - uncomment if using Docker/Singularity)
    // container = 'continuumio/miniconda3:latest'
}

// Generate execution reports. These are resolved at config-parse time, before
// validateParameters() gets a chance to apply nextflow_schema*.json's defaults, and before
// `workflow`/entrypoint-specific state is available to this file -- so they can only key off
// a param that's guaranteed to have a config-level default no matter which entrypoint is
// running. supersample_basename (main.nf/main_simple.nf) is that param; downsample.nf runs
// organize pipeline_info/ here under its own default ("output") rather than --batch_basename
// as a result -- a cosmetic-only quirk (every actual data output already publishes under
// batch_basename via each module's own publishDir, which has no such timing constraint).
timeline {
    enabled = true
    file = "${params.outdir}/${params.supersample_basename}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/${params.supersample_basename}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/${params.supersample_basename}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/${params.supersample_basename}/pipeline_info/dag.svg"
    overwrite = true
}

// Manifest
manifest {
    name = 'single-cell-qc-pipeline'
    author = 'Michael Gatzen'
    description = 'Pipeline for processing single-cell QC metrics'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'  // required by the nf-schema plugin version pinned above
    version = '1.0.0'
}
